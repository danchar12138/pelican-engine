{
  "name": "pelican-engine",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "doctor": "tsx tools/doctor.ts",
    "setup": "tsx tools/setup.ts",
    "dev": "tsx tools/cli.ts dev",
    "typecheck": "tsc --noEmit",
    "verify:ai": "tsx tools/verify-ai-first.ts",
    "probe:quality-comparison": "tsx tools/quality-comparison.ts",
    "test": "node tools/test.mjs",
    "compile": "tsx tools/cli.ts compile",
    "check": "tsx tools/cli.ts check",
    "build": "tsx tools/cli.ts build",
    "optimize": "tsx tools/cli.ts optimize",
    "api:index": "tsx tools/api-index.ts",
    "recipes:generate": "tsx tools/npm/generate-recipes.ts",
    "probe:backends": "tsx tools/backend-probe.ts",
    "probe:compute": "tsx tools/compute-game-probe.ts",
    "probe:compute:numeric": "tsx tools/managed-compute-gpu-probe.ts --exclusive-gpu",
    "probe:postprocess": "tsx tools/postprocess-game-probe.ts",
    "probe:vertex": "tsx tools/vertex-game-probe.ts",
    "probe:compute-render": "tsx tools/compute-render-game-probe.ts",
    "probe:compute-dependencies": "tsx tools/compute-dependencies-game-probe.ts --exclusive-gpu",
    "probe:fragment-buffers": "tsx tools/fragment-buffers-game-probe.ts --exclusive-gpu",
    "probe:compute-textures": "tsx tools/compute-textures-game-probe.ts --exclusive-gpu",
    "probe:render-textures": "tsx tools/render-textures-game-probe.ts --exclusive-gpu",
    "probe:angular-physics": "tsx tools/angular-physics-game-probe.ts --exclusive-gpu",
    "probe:physics-first-removal": "tsx tools/physics-first-removal-probe.ts --exclusive-gpu",
    "probe:physics-zero-init": "tsx tools/physics-zero-init-matrix.ts",
    "probe:m3-material-graph": "tsx tools/m3-material-graph-gpu-probe.ts --exclusive-gpu",
    "probe:opaque-ior": "tsx tools/opaque-ior-game-probe.ts --exclusive-gpu",
    "probe:specular": "tsx tools/specular-game-probe.ts --exclusive-gpu",
    "probe:specular:numeric": "tsx tools/specular-bsdf-gpu-probe.ts --exclusive-gpu",
    "probe:postprocess:occlusion": "tsx tools/postprocess-occlusion-probe.ts --exclusive-gpu",
    "distribution:build": "tsx tools/npm/build.ts",
    "distribution:pack": "npm run distribution:build && npm pack ./.pelican/npm/package --pack-destination ./.pelican/npm/artifacts",
    "distribution:test": "tsx --test --test-concurrency=1 tools/npm/*.test.ts",
    "distribution:smoke": "tsx tools/npm/smoke.ts",
    "distribution:verify-registry": "tsx tools/npm/verify-registry.ts",
    "verify": "npm run typecheck && npm test && npm run distribution:test",
    "release:publish": "node tools/npm/publish.mjs",
    "release:github": "tsx tools/npm/github-release.ts",
    "clean": "node tools/clean.mjs",
    "benchmark:render": "tsx tools/benchmark-rendering.ts",
    "evaluate:author": "tsx tools/evaluate-authoring.ts",
    "evaluate:author:report": "tsx tools/author-evaluation-report.ts"
  },
  "dependencies": {
    "fast-png": "8.0.0",
    "fflate": "0.8.3",
    "ngraph.path": "1.6.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@dimforge/rapier2d-compat": "0.21.0",
    "@dimforge/rapier3d-compat": "0.21.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "@types/ws": "8.18.2",
    "@webgpu/types": "0.1.74",
    "playwright": "1.64.1",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "ws": "8.22.2"
  }
}
