{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "@webgpu/types", "vite/client"],
    "paths": { "@threecat/sdk": ["./packages/sdk/src/index.ts"] }
  },
  "include": [
    "packages/**/*.ts",
    "experiments/**/*.ts",
    "tools/**/*.ts",
    "tests/**/*.ts",
    "examples/**/*.ts",
    "vite.config.ts"
  ]
}
